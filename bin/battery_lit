#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${BATTERY_LIT_PYTHON:-}" && -z "${PAPER_ENGINE_PYTHON:-}" ]]; then
  export PAPER_ENGINE_PYTHON="${BATTERY_LIT_PYTHON}"
fi

echo "warning: battery_lit is deprecated; use paper_engine" >&2
exec "${SCRIPT_DIR}/paper_engine" "$@"
