#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
export PYTHONPATH="${ROOT_DIR}/third_party/paper-search-mcp:${ROOT_DIR}/.backend-deps:${PYTHONPATH:-}"
if [[ -n "${BATTERY_LIT_PYTHON:-}" ]]; then
  PYTHON_BIN="${BATTERY_LIT_PYTHON}"
elif [[ -x /usr/bin/python3.10 ]]; then
  PYTHON_BIN=/usr/bin/python3.10
else
  PYTHON_BIN="$(command -v python3)"
fi

if [[ ! -x "${PYTHON_BIN}" ]]; then
  echo "paper-search: Python interpreter is not executable: ${PYTHON_BIN}" >&2
  exit 1
fi

exec "${PYTHON_BIN}" -m paper_search_mcp.cli "$@"
