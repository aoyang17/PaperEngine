  "remote_agent": {
    "config": "/home/aobo/.paperengine/comsol_remote.json",
    "credential_policy": "external mode-0600 password file; never copied into repository or run artifacts",
    "operations": ["probe", "upload", "submit", "status", "verify", "download"]
